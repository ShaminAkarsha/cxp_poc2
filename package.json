{
  "name": "cxp-poc",
  "version": "0.1.0",
  "private": true,
  "description": "CXP/CXF passkey migration security testbed (research PoC)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "demo:baseline": "tsx src/cli/demo-baseline.ts",
    "rp": "tsx src/rp/main.ts",
    "demo:exchange": "tsx src/cli/demo-exchange.ts",
    "demo:migrate": "tsx src/cli/demo-migrate.ts",
    "demo:e2e": "tsx src/cli/demo-e2e.ts",
    "walkthrough": "tsx src/cli/walkthrough.ts",
    "dashboard": "tsx src/dashboard/main.ts",
    "attack:all": "tsx src/cli/attack-all.ts"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@peculiar/x509": "^2.1.0",
    "@simplewebauthn/server": "^14.0.2",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
